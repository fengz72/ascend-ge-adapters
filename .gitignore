# ===== 模型编译产物与验证数据（体积大，可重新生成）=====
# air/(AIR + pbtxt + io_spec) om/(OM) io/(manifest + bundle + inputs + golden + outputs + pool)
models/*/air/
models/*/om/
models/*/io/
# 性能测试: run 目录/index/sweep 都是**过程产物**(可重跑再生), 一律本地不入库;
# 只有 curate 进 results/README.md 的基线数字入库 (它是 results/ 直属文件, 不被下面目录模式匹配)。
# 请求池在 io/pool, 已被上面 models/*/io/ 覆盖
models/*/results/*/
models/*/results/index.json
models/*/results/sweep-*.md
**/*.so

